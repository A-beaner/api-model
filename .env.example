# Copy this file to .env and fill in your real keys.
# .env is gitignored - NEVER commit your actual API keys.
API_KEY=your-nvidia-api-key-here
STOCK_API_KEY=your-alpha-vantage-key-here
POLYGON_API_KEY=your-polygon-key-here
FINNHUB_API_KEY=your-finnhub-key-here
ALPACA_API_KEY=your-alpaca-paper-key-id-here
ALPACA_SECRET_KEY=your-alpaca-paper-secret-here
SYMBOL=IBM
# Universe rotation (defaults shown; pool defaults to 168 built-in tickers)
# TICKER_POOL=AAPL,MSFT,...
WINDOW_SIZE=30
ROTATE_EVERY_DAYS=7
TOP_N=3
# Set WATCHLIST to a csv of tickers to disable rotation entirely

# Trading limits (plan to trade with less than $100,000)
MAX_PORTFOLIO_VALUE=100000
MAX_TRADE_VALUE=50000
MIN_CASH_PCT=0.05

# Trailing stop-loss: sell if a holding's TOTAL value drops this many USD from its peak
STOP_LOSS_DROP=3.0
# File tracking per-holding peak prices (commit it alongside track_record.csv)
STATE_FILE=stop_state.json

# Outcome feedback: learn from past trades' realized returns
MODEL_MEMORY_FILE=model_memory.csv
PERFORMANCE_WEIGHT=1.0
MEMORY_WINDOW=10
