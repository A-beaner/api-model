# Copy this file to .env and fill in your real keys.
# .env is gitignored - NEVER commit your actual API keys.
API_KEY=your-nvidia-api-key-here
STOCK_API_KEY=your-alpha-vantage-key-here
POLYGON_API_KEY=your-polygon-key-here
FINNHUB_API_KEY=your-finnhub-key-here
ALPACA_API_KEY=your-alpaca-paper-key-id-here
ALPACA_SECRET_KEY=your-alpaca-paper-secret-here
SYMBOL=IBM
# Universe rotation (defaults shown; pool defaults to 60 built-in tickers)
# TICKER_POOL=AAPL,MSFT,...
WINDOW_SIZE=30
ROTATE_EVERY_DAYS=7
TOP_N=3
# Set WATCHLIST to a csv of tickers to disable rotation entirely
